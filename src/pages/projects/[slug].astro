---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout>
	<header class="mb-12 border-b pb-8">
		<a href="/projects" class="text-blue-600 hover:underline text-sm">&larr; All projects</a>
		<h1 class="text-4xl font-bold text-gray-900 mt-4">{project.data.title}</h1>
		<p class="text-gray-500 mt-2">{project.data.category}</p>
		<div class="mt-4 flex gap-6 text-blue-600 font-medium">
			{project.data.github && <a href={project.data.github} target="_blank" class="hover:underline">GitHub</a>}
			{project.data.huggingface && <a href={project.data.huggingface} target="_blank" class="hover:underline">Hugging Face</a>}
		</div>
	</header>

	<article class="prose max-w-none">
		<Content />
	</article>

	<footer class="mt-20 pt-8 border-t text-gray-400 text-sm">
		<p>&copy; 2026 Ibrahim Olanigan. Built with Astro and High-Efficiency principles.</p>
	</footer>
</Layout>
